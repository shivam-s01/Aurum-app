<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded Dynamic Island card — compact "now playing" layout:
  artwork + title/artist + like on the first row, seekbar with mm:ss
  timestamps, a centered transport row (shuffle / prev / play-pause /
  next / audio-route), and an UP NEXT thumbnail strip with the small
  "ASTRA" wordmark. Card width is set by AurumIslandService (340dp,
  capped to the screen); accent/background tints are applied at runtime
  from Settings, the hex values here are only shipped defaults.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/island_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/island_expanded_bg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="14dp"
    android:elevation="10dp">

    <!-- Header: artwork, title/artist, like -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/island_expanded_artwork"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/ic_widget_play"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/island_expanded_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aurum"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:freezesText="true"/>

            <TextView
                android:id="@+id/island_expanded_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textColor="#99FFFFFF"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/island_expanded_like"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="10dp"
            android:padding="2dp"
            android:src="@drawable/ic_like_outline"
            android:contentDescription="@null"/>

    </LinearLayout>

    <!-- Seekbar (draggable; service seeks the player on release) -->
    <SeekBar
        android:id="@+id/island_expanded_seekbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:progressTint="#B89640"
        android:thumbTint="#B89640"
        android:max="1000"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/island_expanded_position"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0:00"
            android:textColor="#99FFFFFF"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/island_expanded_duration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="0:00"
            android:textColor="#99FFFFFF"
            android:textSize="11sp"/>
    </LinearLayout>

    <!-- Transport: shuffle / prev / play-pause / next / audio route.
         Shuffle and route glyph mirror each other so the play button sits
         dead-center. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <ImageView
            android:id="@+id/island_expanded_shuffle"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="5dp"
            android:src="@drawable/ic_island_wave"
            android:contentDescription="@null"/>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/island_expanded_prev"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_widget_prev"
            android:contentDescription="@null"/>

        <Space
            android:layout_width="20dp"
            android:layout_height="1dp"/>

        <ImageView
            android:id="@+id/island_expanded_play_pause"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_widget_play"
            android:contentDescription="@null"/>

        <Space
            android:layout_width="20dp"
            android:layout_height="1dp"/>

        <ImageView
            android:id="@+id/island_expanded_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_widget_next"
            android:contentDescription="@null"/>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/island_expanded_route_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="5dp"
            android:src="@drawable/ic_island_speaker"
            android:contentDescription="@null"/>

    </LinearLayout>

    <!-- UP NEXT label + wordmark -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="UP NEXT"
            android:textColor="#66FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"/>

        <TextView
            android:id="@+id/island_expanded_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ASTRA"
            android:textColor="#B89640"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:singleLine="true"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/island_expanded_queue_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView
            android:id="@+id/island_queue_thumb_1"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/ic_widget_play"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>

        <ImageView
            android:id="@+id/island_queue_thumb_2"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/ic_widget_play"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>

        <ImageView
            android:id="@+id/island_queue_thumb_3"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/ic_widget_play"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>

        <ImageView
            android:id="@+id/island_queue_thumb_4"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/ic_widget_play"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>

    </LinearLayout>

</LinearLayout>
