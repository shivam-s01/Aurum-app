<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded Dynamic Island card — Spotify-full-player-style layout:
  big artwork on top, title/artist below it, seekbar with mm:ss
  timestamps either side, a 4-icon transport row (shuffle/prev/
  play-pause/next), a small "Astra" wordmark + audio-route glyph up
  top, and an UP NEXT thumbnail strip at the bottom. Colors here are
  the shipped defaults; AurumIslandService overwrites the
  background/accent tints at runtime from the user's Settings ->
  Player customization (position/size/color), so the hex values below
  only matter for res/layout preview purposes.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/island_expanded_root"
    android:layout_width="336dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/island_expanded_bg"
    android:padding="18dp"
    android:elevation="10dp">

    <!-- Top bar: Astra wordmark (left) + audio-route glyph (right) —
         mirrors Spotify's own app-icon-top-left / cast-icon-top-right
         header row on its full-player card. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/island_expanded_wordmark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ASTRA"
            android:textColor="#B89640"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:fontFamily="sans-serif-medium"/>

        <ImageView
            android:id="@+id/island_expanded_route_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_island_speaker"
            android:contentDescription="@null"/>

    </LinearLayout>

    <!-- Big artwork, full card width, square — the visual centerpiece,
         matching Spotify's own full-player art size/placement instead
         of the old small 48dp thumbnail-next-to-title layout. -->
    <ImageView
        android:id="@+id/island_expanded_artwork"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0"
        android:background="@drawable/ic_widget_play"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:adjustViewBounds="true"/>

    <!-- Title/artist + like ("+") button row, right under the artwork -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/island_expanded_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aurum"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:selected="true"
                android:freezesText="true"/>

            <TextView
                android:id="@+id/island_expanded_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text=""
                android:textColor="#99FFFFFF"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/island_expanded_like"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="12dp"
            android:padding="1dp"
            android:src="@drawable/ic_like_outline"
            android:contentDescription="@null"/>

    </LinearLayout>

    <!-- Seekbar — draggable; AurumIslandService seeks the player live on
         user drag via SeekBar.OnSeekBarChangeListener, same as tapping a
         position on Spotify's own progress bar. Thumb is enlarged over
         the pill-era version so it's a comfortable drag target. -->
    <SeekBar
        android:id="@+id/island_expanded_seekbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:progressTint="#B89640"
        android:thumbTint="#B89640"
        android:max="1000"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/island_expanded_position"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0:00"
            android:textColor="#99FFFFFF"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/island_expanded_duration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="0:00"
            android:textColor="#99FFFFFF"
            android:textSize="11sp"/>
    </LinearLayout>

    <!-- Transport controls: shuffle / prev / play-pause / next —
         bigger targets than the old layout (Spotify-style prominence
         for the center play/pause button). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:baselineAligned="false">

        <ImageView
            android:id="@+id/island_expanded_shuffle"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="5dp"
            android:src="@drawable/ic_island_wave"
            android:contentDescription="@null"/>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/island_expanded_prev"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_widget_prev"
            android:contentDescription="@null"/>

        <Space
            android:layout_width="22dp"
            android:layout_height="1dp"/>

        <!-- Play/pause: AurumIslandService swaps this drawable and runs a
             quick scale-pop (1.0 -> 1.18 -> 1.0) on every toggle — the
             "icon-swap + scale-pop" approach agreed on in place of
             porting the Dart player's full triangle<->bars path morph
             (aurum_play_pause_icon.dart) into native XML/Kotlin. -->
        <ImageView
            android:id="@+id/island_expanded_play_pause"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_widget_play"
            android:contentDescription="@null"/>

        <Space
            android:layout_width="22dp"
            android:layout_height="1dp"/>

        <ImageView
            android:id="@+id/island_expanded_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_widget_next"
            android:contentDescription="@null"/>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <!-- Right-side spacer matching the shuffle icon's footprint so
             prev/play/next stay visually centered (Spotify's own row has
             shuffle on the far left and repeat on the far right; Aurum
             doesn't have a repeat-mode toggle on this card, so this is a
             blank same-size spacer rather than a dead-looking icon). -->
        <Space
            android:layout_width="30dp"
            android:layout_height="30dp"/>

    </LinearLayout>

    <!-- UP NEXT label + queue thumbnail row -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="UP NEXT"
        android:textColor="#66FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"/>

    <LinearLayout
        android:id="@+id/island_expanded_queue_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView
            android:id="@+id/island_queue_thumb_1"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/ic_widget_play"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>

        <ImageView
            android:id="@+id/island_queue_thumb_2"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/ic_widget_play"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>

        <ImageView
            android:id="@+id/island_queue_thumb_3"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/ic_widget_play"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>

        <ImageView
            android:id="@+id/island_queue_thumb_4"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/ic_widget_play"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>

    </LinearLayout>

</LinearLayout>
