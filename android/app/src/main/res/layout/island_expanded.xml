<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded Dynamic Island card.
  Row 1: artwork / title + artist / like.
  Row 2: seekbar + timestamps.
  Row 3: shuffle / prev / play-pause (white disc) / next / audio route.
  Row 4: UP NEXT - four equal, perfectly square, tappable tiles. Their pixel
         size is computed in AurumIslandService from the card width so the row
         fills the card exactly; the rounded shape comes from a view outline
         (not baked into the bitmap) so all four are identical.
  Card width, top padding (kept clear of the camera hole) and colors are set at
  runtime; the values here are only defaults.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/island_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/island_expanded_bg"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="18dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/island_expanded_artwork"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/island_thumb_placeholder"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/island_expanded_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aurum"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:freezesText="true"/>

            <TextView
                android:id="@+id/island_expanded_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text=""
                android:textColor="#B3FFFFFF"
                android:textSize="13.5sp"
                android:singleLine="true"
                android:ellipsize="end"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/island_expanded_like"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:padding="10dp"
            android:background="@drawable/island_ripple_circle"
            android:src="@drawable/ic_like_outline"
            android:contentDescription="Like"/>

    </LinearLayout>

    <!-- Seekbar. Negative margins + equal padding keep the thumb fully inside
         the view while the track lines up with the card's content edges. -->
    <SeekBar
        android:id="@+id/island_expanded_seekbar"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="-6dp"
        android:layout_marginEnd="-6dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:progressDrawable="@drawable/island_seekbar_progress"
        android:thumb="@drawable/island_seek_thumb"
        android:progressTint="#B89640"
        android:minHeight="4dp"
        android:maxHeight="4dp"
        android:splitTrack="false"
        android:max="1000"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-3dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/island_expanded_position"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0:00"
            android:textColor="#A6FFFFFF"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/island_expanded_duration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="0:00"
            android:textColor="#A6FFFFFF"
            android:textSize="11sp"/>
    </LinearLayout>

    <!-- Transport. Shuffle and route icons mirror each other so the play disc
         sits dead-center. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <ImageView
            android:id="@+id/island_expanded_shuffle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:background="@drawable/island_ripple_circle"
            android:src="@drawable/ic_island_shuffle"
            android:contentDescription="Shuffle"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/island_expanded_prev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:background="@drawable/island_ripple_circle"
            android:src="@drawable/ic_widget_prev"
            android:contentDescription="Previous"/>

        <View
            android:layout_width="14dp"
            android:layout_height="1dp"/>

        <ImageView
            android:id="@+id/island_expanded_play_pause"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:padding="18dp"
            android:background="@drawable/island_play_bg"
            android:src="@drawable/ic_widget_play"
            android:tint="#FF14131A"
            android:contentDescription="Play or pause"/>

        <View
            android:layout_width="14dp"
            android:layout_height="1dp"/>

        <ImageView
            android:id="@+id/island_expanded_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:background="@drawable/island_ripple_circle"
            android:src="@drawable/ic_widget_next"
            android:contentDescription="Next"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/island_expanded_route_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:src="@drawable/ic_island_speaker"
            android:contentDescription="@null"/>

    </LinearLayout>

    <!-- UP NEXT label + wordmark -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="UP NEXT"
            android:textColor="#80FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.14"/>

        <TextView
            android:id="@+id/island_expanded_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ASTRA"
            android:textColor="#B89640"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:singleLine="true"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>

    <!-- Four equal squares. Width/height/margins are overwritten at runtime
         (AurumIslandService.sizeQueueThumbs); 64dp is only the fallback. -->
    <LinearLayout
        android:id="@+id/island_expanded_queue_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/island_queue_thumb_1"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/island_thumb_placeholder"
            android:scaleType="centerCrop"
            android:contentDescription="Up next 1"/>

        <ImageView
            android:id="@+id/island_queue_thumb_2"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/island_thumb_placeholder"
            android:scaleType="centerCrop"
            android:contentDescription="Up next 2"/>

        <ImageView
            android:id="@+id/island_queue_thumb_3"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/island_thumb_placeholder"
            android:scaleType="centerCrop"
            android:contentDescription="Up next 3"/>

        <ImageView
            android:id="@+id/island_queue_thumb_4"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/island_thumb_placeholder"
            android:scaleType="centerCrop"
            android:contentDescription="Up next 4"/>

    </LinearLayout>

</LinearLayout>
