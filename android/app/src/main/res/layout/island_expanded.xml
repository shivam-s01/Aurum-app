<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded Dynamic Island card — same information density as the
  Spotify-style reference (art, title/artist, seekbar+timestamps,
  shuffle/prev/play-pause/next, small queue thumbnail row), reskinned in
  Aurum's dark/gold brand instead of Spotify red. Lives in the same
  WindowManager overlay slot the pill occupies — AurumIslandService swaps
  between the two layouts rather than stacking both.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/island_expanded_root"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/island_expanded_bg"
    android:padding="16dp"
    android:elevation="8dp">

    <!-- Top row: artwork + title/artist -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/island_expanded_artwork"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/ic_widget_play"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/island_expanded_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aurum"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/island_expanded_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textColor="#99FFFFFF"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Seekbar + timestamps -->
    <SeekBar
        android:id="@+id/island_expanded_seekbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:progressTint="#B89640"
        android:thumbTint="#B89640"
        android:max="1000"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/island_expanded_position"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0:00"
            android:textColor="#99FFFFFF"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/island_expanded_duration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="0:00"
            android:textColor="#99FFFFFF"
            android:textSize="11sp"/>
    </LinearLayout>

    <!-- Transport controls: shuffle / prev / play-pause / next -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:baselineAligned="false">

        <ImageView
            android:id="@+id/island_expanded_shuffle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="4dp"
            android:src="@drawable/ic_island_wave"
            android:contentDescription="@null"/>

        <Space
            android:layout_width="20dp"
            android:layout_height="1dp"/>

        <ImageView
            android:id="@+id/island_expanded_prev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_widget_prev"
            android:contentDescription="@null"/>

        <Space
            android:layout_width="20dp"
            android:layout_height="1dp"/>

        <ImageView
            android:id="@+id/island_expanded_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_widget_play"
            android:contentDescription="@null"/>

        <Space
            android:layout_width="20dp"
            android:layout_height="1dp"/>

        <ImageView
            android:id="@+id/island_expanded_next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_widget_next"
            android:contentDescription="@null"/>

    </LinearLayout>

    <!-- Queue thumbnail row — next 4 upcoming songs -->
    <LinearLayout
        android:id="@+id/island_expanded_queue_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView
            android:id="@+id/island_queue_thumb_1"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/ic_widget_play"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>

        <ImageView
            android:id="@+id/island_queue_thumb_2"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/ic_widget_play"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>

        <ImageView
            android:id="@+id/island_queue_thumb_3"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/ic_widget_play"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>

        <ImageView
            android:id="@+id/island_queue_thumb_4"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/ic_widget_play"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>

    </LinearLayout>

</LinearLayout>
