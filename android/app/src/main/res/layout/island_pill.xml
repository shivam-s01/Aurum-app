<?xml version="1.0" encoding="utf-8"?>
<!--
  Collapsed Dynamic Island.

  The window is deliberately LARGER than the visible pill: an invisible hit
  margin (sides + bottom, sized in AurumIslandService) surrounds the black
  capsule, so a tap that lands a little off - or on the dead glass right around
  the camera hole - still opens the card.

  Inside the capsule the layout is mirror-symmetric: artwork slot on the left
  cap, equalizer slot on the right cap (both the same square size), and a
  flexible "camera zone" spacer in between. Sizes/paddings are set at runtime
  from the pill height so the cap contents are always concentric.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/island_pill_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:contentDescription="Now playing. Tap to expand.">

    <LinearLayout
        android:id="@+id/island_pill_body"
        android:layout_width="101dp"
        android:layout_height="32dp"
        android:layout_gravity="top|center_horizontal"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/island_pill_bg"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/island_pill_artwork"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/island_art_circle_placeholder"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>

        <!-- Camera zone -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <!-- Equalizer slot: same square as the artwork so both caps mirror. -->
        <FrameLayout
            android:id="@+id/island_pill_wave_slot"
            android:layout_width="24dp"
            android:layout_height="24dp">

            <LinearLayout
                android:id="@+id/island_pill_wave"
                android:layout_width="13dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <View
                    android:id="@+id/island_wave_bar_1"
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/ic_island_wave_bar"/>

                <View
                    android:id="@+id/island_wave_bar_2"
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/ic_island_wave_bar"/>

                <View
                    android:id="@+id/island_wave_bar_3"
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:background="@drawable/ic_island_wave_bar"/>
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

</FrameLayout>
