<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <!--
      Aurum's OS-level animated splash icon. Timeline, stage count, group
      nesting, durations, offsets and easings are copied directly from
      Echo Nightly's own art_splash_anim.xml (2400ms total, wrapper at
      0.6 scale, bg/ring/note_group/note four independently-timed
      targets) - only the actual shapes are Aurum's own, traced from the
      real logo PNG (36039.png). See art_splash_anim.xml (the static
      version) for the trace/extraction method.

      DELIBERATE DIFFERENCE FROM ECHO: Echo's own "note" target morphs
      away from its play-triangle and then, at 1600ms, morphs BACK to
      the play-triangle (so Echo's splash ends on the same icon it
      started with - a decorative wobble, not a reveal). That reverse
      morph is dropped here on purpose: the whole point of this splash
      is to end on Aurum's real note, not snap back to the placeholder
      triangle. Echo's "path_5"/"path_6" - two tiny decorative accent
      marks specific to Echo's own play-icone artwork with no
      equivalent in Aurum's logo - are dropped for the same reason:
      they have nothing to attach to here.

      Morph safety: the play-triangle below is NOT Echo's curved
      triangle pathData - it's a from-scratch 19-point straight-line
      polygon (M + 19 L's + Z) built to have the exact same command
      count and type as Aurum's real note shape (also M + 19 L's + Z),
      with each point manually corresponded to its counterpart on the
      note. Verified by rendering interpolated in-between frames before
      use - no self-intersection or zigzag.
    -->
    <aapt:attr name="android:drawable">
        <vector
            android:name="vector"
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <group
                android:pivotX="12"
                android:pivotY="12"
                android:scaleX="0.6"
                android:scaleY="0.6">
                <group
                    android:name="bg"
                    android:pivotX="12"
                    android:pivotY="12">
                    <!-- Plain circle, same role as Echo's own "bg" -
                         a soft duplicate spinning underneath everything,
                         not the scalloped badge shape itself. -->
                    <path android:pathData="M 12 2 C 9.349 2 6.803 3.055 4.929 4.929 C 3.055 6.803 2 9.349 2 12 C 2 14.651 3.055 17.197 4.929 19.071 C 6.803 20.945 9.349 22 12 22 C 14.651 22 17.197 20.945 19.071 19.071 C 20.945 17.197 22 14.651 22 12 C 22 9.349 20.945 6.803 19.071 4.929 C 17.197 3.055 14.651 2 12 2 Z">
                        <aapt:attr name="android:fillColor">
                            <gradient
                                android:centerX="7"
                                android:centerY="7"
                                android:gradientRadius="16"
                                android:type="radial">
                                <item android:color="#F0A7C6" android:offset="0" />
                                <item android:color="#5C7FE0" android:offset="1" />
                            </gradient>
                        </aapt:attr>
                    </path>
                </group>
                <group
                    android:name="note_group"
                    android:pivotX="12"
                    android:pivotY="12">
                    <!-- Same role as Echo's "play" group: rotation +
                         translateY wobble on the wrapper, independent
                         of the pathData morph on the path inside it. -->
                    <path
                        android:name="note"
                        android:fillColor="#16191C"
                        android:pathData="M 9.750 8.750 L 10.536 9.232 L 11.321 9.714 L 12.107 10.196 L 12.893 10.679 L 13.679 11.161 L 14.464 11.643 L 15.250 12.125 L 14.333 12.688 L 13.417 13.250 L 12.500 13.812 L 11.583 14.375 L 10.667 14.938 L 9.750 15.500 L 9.750 14.375 L 9.750 13.250 L 9.750 12.125 L 9.750 11.000 L 9.750 9.875 Z" />
                </group>
                <group
                    android:name="ring"
                    android:pivotX="12"
                    android:pivotY="12">
                    <!-- Aurum's real scallop badge silhouette. -->
                    <path
                        android:name="ring_path"
                        android:pathData="M 11.500 3.875 L 10.000 5.125 L 8.250 5.125 L 6.625 6.250 L 6.375 8.125 L 4.875 9.500 L 4.500 10.250 L 4.500 11.500 L 5.375 12.875 L 5.000 14.250 L 5.375 16.000 L 6.000 16.625 L 7.250 17.000 L 8.500 18.750 L 10.375 19.125 L 11.375 19.875 L 12.250 20.000 L 13.625 19.125 L 15.375 18.875 L 16.875 17.000 L 18.500 16.250 L 19.000 15.250 L 18.625 12.875 L 19.500 11.625 L 19.625 10.500 L 19.250 9.500 L 17.750 8.250 L 17.625 6.625 L 17.000 5.625 L 16.125 5.125 L 14.125 5.125 L 12.875 4.000 Z">
                        <aapt:attr name="android:fillColor">
                            <gradient
                                android:startX="4"
                                android:startY="4"
                                android:endX="20"
                                android:endY="20"
                                android:type="linear">
                                <item android:color="#F0A7C6" android:offset="0" />
                                <item android:color="#8B7FD6" android:offset="0.5" />
                                <item android:color="#5C7FE0" android:offset="1" />
                            </gradient>
                        </aapt:attr>
                    </path>
                </group>
            </group>
        </vector>
    </aapt:attr>

    <!-- ring: identical timing to Echo's own "ring" target - two
         back-to-back 1200ms bursts, net 240° rotation. -->
    <target android:name="ring">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="1200"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="rotation"
                    android:valueFrom="0"
                    android:valueTo="120"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="1200"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="rotation"
                    android:startOffset="1200"
                    android:valueFrom="120"
                    android:valueTo="240"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <!-- note: play-triangle morphs into Aurum's real note shape.
         Same start offset/duration as Echo's own first "note" morph
         (200ms offset, 400ms duration) - but no reverse morph at
         1600ms, since the goal is to land on and stay on the real
         logo, not snap back to the triangle placeholder. -->
    <target android:name="note">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="400"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="pathData"
                android:startOffset="200"
                android:valueFrom="M 9.750 8.750 L 10.536 9.232 L 11.321 9.714 L 12.107 10.196 L 12.893 10.679 L 13.679 11.161 L 14.464 11.643 L 15.250 12.125 L 14.333 12.688 L 13.417 13.250 L 12.500 13.812 L 11.583 14.375 L 10.667 14.938 L 9.750 15.500 L 9.750 14.375 L 9.750 13.250 L 9.750 12.125 L 9.750 11.000 L 9.750 9.875 Z"
                android:valueTo="M 12.375 8.250 L 11.875 8.375 L 11.875 11.750 L 11.625 12.000 L 10.500 11.875 L 9.750 12.250 L 9.000 13.500 L 9.000 14.375 L 9.625 15.500 L 10.500 16.000 L 11.625 16.000 L 12.375 15.625 L 12.875 15.000 L 13.125 14.125 L 13.250 10.750 L 14.875 11.625 L 15.250 11.625 L 15.375 11.375 L 15.250 10.125 Z"
                android:valueType="pathType" />
        </aapt:attr>
    </target>

    <!-- note_group: same rotation+translateY wobble timing as Echo's
         "play" target (400ms offset rotate out, hold, 1700ms offset
         rotate back) - the triangle-shaped note tilts as it morphs,
         then settles back level once it's the real note shape. -->
    <target android:name="note_group">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="400"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="rotation"
                    android:startOffset="400"
                    android:valueFrom="0"
                    android:valueTo="-52"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="400"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="translateY"
                    android:startOffset="400"
                    android:valueFrom="0"
                    android:valueTo="2"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="300"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="rotation"
                    android:startOffset="1700"
                    android:valueFrom="-52"
                    android:valueTo="0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="300"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="translateY"
                    android:startOffset="1700"
                    android:valueFrom="2"
                    android:valueTo="0"
                    android:valueType="floatType" />
                <!-- scale-pulse, same role as Echo's "media" target -->
                <objectAnimator
                    android:duration="300"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:startOffset="700"
                    android:valueFrom="1"
                    android:valueTo="1.05"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="300"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:startOffset="700"
                    android:valueFrom="1"
                    android:valueTo="1.05"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="200"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:startOffset="1000"
                    android:valueFrom="1.05"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="200"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:startOffset="1000"
                    android:valueFrom="1.05"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="300"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:startOffset="1700"
                    android:valueFrom="1"
                    android:valueTo="1.05"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="301"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:startOffset="1700"
                    android:valueFrom="1"
                    android:valueTo="1.05"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="200"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:startOffset="2000"
                    android:valueFrom="1.05"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="200"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:startOffset="2000"
                    android:valueFrom="1.05"
                    android:valueTo="1"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <!-- bg: same 2400ms full-turn spin as Echo's own "bg" target. -->
    <target android:name="bg">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="2400"
                    android:interpolator="@android:interpolator/anticipate_overshoot"
                    android:propertyName="rotation"
                    android:valueFrom="0"
                    android:valueTo="360"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
