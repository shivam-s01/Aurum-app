<?xml version="1.0" encoding="utf-8"?>
<!--
  Aurum's OS-level animated splash icon — set directly as
  android:windowSplashScreenAnimatedIcon in themes.xml, exactly the way
  Echo Nightly's own art_splash_anim.xml is wired up (see Echo's
  values/themes.xml: windowSplashScreenBackground + windowSplashScreenAnimatedIcon
  + windowSplashScreenAnimationDuration + windowSplashScreenBehavior +
  windowSplashScreenBrandingImage, all set together, no MainActivity-side
  avoidance, no separate values-v31 override). Aurum previously deliberately
  left this attribute UNSET specifically to dodge a MIUI/OxygenOS bug where
  setting an animated icon forces it onto a light "icon card" — but Echo's
  own file sets this exact attribute with no such workaround, so the
  MIUI card behavior is a property of what value you give the OS for
  windowSplashScreenIconBackgroundColor (or leaving the OS to guess), not
  of setting windowSplashScreenAnimatedIcon itself. Leaving it unset meant
  MIUI fell back to ITS OWN default splash — the bare static launcher
  icon sitting in a dark rounded-square card, with zero animation, for
  the entire time before Flutter's first frame — which is exactly the
  "nothing animates, kuch dikh hi nahi raha" symptom being fixed here.

  Two vector paths, traced directly from Aurum's own scallop_ring.png
  (outer scalloped-ring silhouette + the note-shaped hole punched out of
  it via fillType="evenOdd") — so this is Aurum's real logo shape, not a
  generic music-note placeholder. See splash_screen.dart's note_glyph.png
  derivation for the same underlying trace method.

  Structure mirrors Echo's own <target> layout: a "ring" group that
  rotates, a "note" group that tilts independently, and a "bg" group
  underneath that does a slow full rotation — same three moving parts,
  same relative roles, just this app's own outline data.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:name="vector"
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <group
                android:name="bg"
                android:pivotX="12"
                android:pivotY="12">
                <path
                    android:pathData="M 11.72 0.39 L 11.22 0.50 L 10.44 0.94 L 10.00 1.50 L 9.28 2.11 L 9.00 2.22 L 7.78 2.06 L 6.94 2.11 L 5.83 2.61 L 5.06 3.39 L 4.61 4.28 L 4.50 4.78 L 4.50 6.22 L 4.33 6.56 L 4.00 6.89 L 3.17 7.39 L 2.44 8.22 L 2.11 9.00 L 2.06 10.22 L 2.44 11.33 L 3.06 12.06 L 3.33 12.67 L 3.28 13.28 L 2.83 14.33 L 2.83 15.50 L 3.06 16.17 L 3.39 16.72 L 4.39 17.61 L 4.78 17.78 L 5.50 17.89 L 5.94 18.11 L 6.22 18.39 L 6.83 19.67 L 7.61 20.33 L 8.72 20.72 L 9.78 20.72 L 11.22 21.72 L 11.56 21.83 L 12.44 21.89 L 13.22 21.61 L 14.39 20.72 L 15.56 20.72 L 16.72 20.28 L 17.44 19.61 L 18.06 18.33 L 18.28 18.11 L 18.72 17.89 L 19.44 17.78 L 20.06 17.50 L 20.94 16.61 L 21.33 15.72 L 21.44 14.83 L 21.33 14.17 L 20.94 13.33 L 20.89 12.67 L 21.11 12.11 L 21.61 11.56 L 22.06 10.67 L 22.17 9.44 L 22.00 8.67 L 21.39 7.67 L 20.72 7.11 L 20.17 6.83 L 19.83 6.50 L 19.67 6.11 L 19.67 4.56 L 19.33 3.61 L 18.78 2.89 L 18.28 2.50 L 17.17 2.06 L 16.22 2.06 L 15.50 2.22 L 15.00 2.17 L 14.67 2.00 L 14.11 1.33 L 13.33 0.67 L 12.78 0.44 Z"
                    android:fillAlpha="0.45">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:centerX="7"
                            android:centerY="7"
                            android:gradientRadius="17"
                            android:type="radial">
                            <item android:color="#F0A7C6" android:offset="0" />
                            <item android:color="#5C7FE0" android:offset="1" />
                        </gradient>
                    </aapt:attr>
                </path>
            </group>
            <group
                android:name="ring"
                android:pivotX="12"
                android:pivotY="12">
                <path
                    android:name="ring_path"
                    android:pathData="M 11.72 0.39 L 11.22 0.50 L 10.44 0.94 L 10.00 1.50 L 9.28 2.11 L 9.00 2.22 L 7.78 2.06 L 6.94 2.11 L 5.83 2.61 L 5.06 3.39 L 4.61 4.28 L 4.50 4.78 L 4.50 6.22 L 4.33 6.56 L 4.00 6.89 L 3.17 7.39 L 2.44 8.22 L 2.11 9.00 L 2.06 10.22 L 2.44 11.33 L 3.06 12.06 L 3.33 12.67 L 3.28 13.28 L 2.83 14.33 L 2.83 15.50 L 3.06 16.17 L 3.39 16.72 L 4.39 17.61 L 4.78 17.78 L 5.50 17.89 L 5.94 18.11 L 6.22 18.39 L 6.83 19.67 L 7.61 20.33 L 8.72 20.72 L 9.78 20.72 L 11.22 21.72 L 11.56 21.83 L 12.44 21.89 L 13.22 21.61 L 14.39 20.72 L 15.56 20.72 L 16.72 20.28 L 17.44 19.61 L 18.06 18.33 L 18.28 18.11 L 18.72 17.89 L 19.44 17.78 L 20.06 17.50 L 20.94 16.61 L 21.33 15.72 L 21.44 14.83 L 21.33 14.17 L 20.94 13.33 L 20.89 12.67 L 21.11 12.11 L 21.61 11.56 L 22.06 10.67 L 22.17 9.44 L 22.00 8.67 L 21.39 7.67 L 20.72 7.11 L 20.17 6.83 L 19.83 6.50 L 19.67 6.11 L 19.67 4.56 L 19.33 3.61 L 18.78 2.89 L 18.28 2.50 L 17.17 2.06 L 16.22 2.06 L 15.50 2.22 L 15.00 2.17 L 14.67 2.00 L 14.11 1.33 L 13.33 0.67 L 12.78 0.44 Z">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:startX="4"
                            android:startY="4"
                            android:endX="20"
                            android:endY="20"
                            android:type="linear">
                            <item android:color="#F0A7C6" android:offset="0" />
                            <item android:color="#8B7FD6" android:offset="0.5" />
                            <item android:color="#5C7FE0" android:offset="1" />
                        </gradient>
                    </aapt:attr>
                </path>
            </group>
            <group
                android:name="note"
                android:pivotX="12"
                android:pivotY="12">
                <path
                    android:name="note_path"
                    android:fillColor="#1D1D1B"
                    android:pathData="M 12.56 6.28 L 16.50 8.78 L 16.61 9.00 L 16.61 10.67 L 16.39 10.94 L 16.06 11.00 L 13.78 9.67 L 13.67 9.78 L 13.67 14.22 L 13.44 15.06 L 13.17 15.56 L 12.28 16.39 L 11.44 16.72 L 10.50 16.78 L 9.89 16.61 L 9.11 16.17 L 8.56 15.56 L 8.22 14.94 L 8.06 14.44 L 8.06 13.33 L 8.22 12.83 L 8.61 12.17 L 9.17 11.61 L 9.67 11.28 L 10.39 11.06 L 11.28 11.06 L 11.67 11.17 L 11.83 11.11 L 11.83 6.67 L 12.06 6.33 Z" />
            </group>
        </vector>
    </aapt:attr>

    <!-- ring: two back-to-back 120° bursts, net 240° — identical
         structure to Echo's own "ring" target (two objectAnimators,
         0-1200ms and 1200-2400ms of the 900ms-visible window scaled to
         this drawable's own animation duration below). -->
    <target android:name="ring">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="450"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="rotation"
                    android:valueFrom="0"
                    android:valueTo="120"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="450"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="rotation"
                    android:startOffset="450"
                    android:valueFrom="120"
                    android:valueTo="240"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <!-- note: tilt out, hold, tilt back — same role as Echo's
         "play"/"note" targets (independent motion from the ring, on
         its own overshoot-flavoured timing). -->
    <target android:name="note">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="250"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="rotation"
                    android:startOffset="150"
                    android:valueFrom="0"
                    android:valueTo="-16"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="200"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="rotation"
                    android:startOffset="640"
                    android:valueFrom="-16"
                    android:valueTo="0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="200"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:startOffset="260"
                    android:valueFrom="1"
                    android:valueTo="1.08"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="200"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:startOffset="260"
                    android:valueFrom="1"
                    android:valueTo="1.08"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="200"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:startOffset="500"
                    android:valueFrom="1.08"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="200"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:startOffset="500"
                    android:valueFrom="1.08"
                    android:valueTo="1"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <!-- bg: slow continuous full turn underneath everything — same
         role as Echo's "bg" target. -->
    <target android:name="bg">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="900"
                    android:interpolator="@android:interpolator/linear"
                    android:propertyName="rotation"
                    android:valueFrom="0"
                    android:valueTo="135"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
