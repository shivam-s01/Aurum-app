<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded Dynamic Island card background — dark, Aurum-gold-bordered,
  Spotify-red-card-style but brand-consistent (gold instead of red). Always
  dark regardless of system theme since this sits directly under the
  camera cutout, same reasoning as island_pill_bg.
-->
