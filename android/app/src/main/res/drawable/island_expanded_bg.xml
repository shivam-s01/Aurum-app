<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded card background. Colors are replaced at runtime with a 3-stop
  gradient sampled from the album art (dark top that melts into the camera,
  colored middle, deeper bottom). These are only the "no artwork yet" defaults.
  Always dark so white text stays readable on any system theme.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#FF0E0D14"
        android:centerColor="#FF1C1B27"
        android:endColor="#FF111018"/>
    <corners android:radius="34dp"/>
    <stroke android:width="1dp" android:color="#26FFFFFF"/>
</shape>
